# NooshAI测试环境配置

# 测试环境URL
BASE_URL=https://nooshchat.qa2.noosh.com
AUTH_URL=https://nooshauth.qa2.noosh.com/login

# 测试账号
TEST_USERNAME=dgo1g1mgr1
TEST_PASSWORD=noosh123

# 浏览器配置
# 可选值: chromium, firefox, webkit
BROWSER=chromium
# True 或 False
HEADLESS=False
# 慢动作模式(毫秒)，调试时可设置为100-500
SLOW_MO=0

# AI/LLM配置
# anthropic 或 openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI配置 (可选，用于备选验证)
OPENAI_API_KEY=your_openai_api_key_here

# RAG配置
ENABLE_RAG=True
EMBEDDING_MODEL=text-embedding-3-small

# 测试执行配置
# 默认超时(毫秒)
DEFAULT_TIMEOUT=30000
# 页面加载超时(毫秒)
PAGE_LOAD_TIMEOUT=60000
# AI响应超时(毫秒)
AI_RESPONSE_TIMEOUT=120000

# 报告配置
SCREENSHOT_ON_FAILURE=True
VIDEO_ON_FAILURE=True
TRACE_ON_FAILURE=True

# AI增强功能开关
ENABLE_LLM_VALIDATION=True
ENABLE_VISUAL_VALIDATION=True
